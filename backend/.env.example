# Copy to .env and fill in real values. Never commit .env.
FLICKR_API_KEY=your-flickr-api-key
MAPILLARY_TOKEN=your-mapillary-token
OPENVERSE_CLIENT_ID=your-openverse-client-id
OPENVERSE_CLIENT_SECRET=your-openverse-client-secret
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
KAKAO_API_KEY=your-kakao-api-key
LLM_API_KEY=your-llm-api-key
VISION_ENABLED=1
VISION_MAX_CANDIDATES=140
# Borderline photos checked by Claude per profile (needs LLM_API_KEY); 0 = off
CLAUDE_VISION_MAX=200
# Optional cap on reliable photos per category, e.g. campus=60,dorms=20; empty = no cap
PHOTO_TARGETS=

# Deployed frontend origin, allowed by CORS in addition to http://localhost:3000
FRONTEND_URL=https://visual-campus.example.com

# Per-source timeout for external APIs, seconds
SOURCE_TIMEOUT_S=5
# Daily cap on Claude spending (photo check + summary + guide chat), USD; 0 = Claude off
AI_DAILY_BUDGET_USD=2
